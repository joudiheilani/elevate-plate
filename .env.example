# Leave unset to use a local SQLite file (mealplanner.db).
# In production, set this to your Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Insert a few sample recipes when the database is empty.
SEED_SAMPLE_DATA=true

